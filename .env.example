# Copy to .env and fill in. Never commit .env — it is gitignored.
# No real values are stored in this repo.

# Server port (default 3000)
PORT=3000

# PayPal sandbox credentials (PayPal Developer dashboard, sandbox app).
# The client ID is a public identifier; the secret never leaves the server.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Gemini API key (PAID API only — never the free AI Studio tier).
# Create it in Google Cloud / AI Studio with billing enabled.
GEMINI_API_KEY=

# Optional: path to a Chrome/Chromium binary if Playwright's own is not used.
# CHROME_PATH=/usr/bin/google-chrome
